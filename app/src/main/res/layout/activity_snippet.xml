<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F3FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#2467FF"
            android:padding="15dp"
            android:radius="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CodeQuiz"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Snippet"
                android:textColor="#FFFFFF"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:30"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- Soal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/robot_quiz"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soal 4/5"
                android:textColor="#334155"
                android:textSize="16sp"
                android:layout_marginLeft="10dp"/>
        </LinearLayout>

        <!-- PROGRESS BAR -->
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:progress="80"
            android:progressTint="#2467FF"
            android:backgroundTint="#BFD7FF"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_marginTop="5dp"/>

        <!-- DRAG AREA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/box_area"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:padding="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERET KODE KE SINI"
                android:textColor="#6B7280"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <!-- Kotak grid -->
            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rowCount="3"
                android:columnCount="4"
                android:alignmentMode="alignMargins"
                android:rowOrderPreserved="false">

                <!-- 12 kotak -->
                <View
                    android:layout_width="65dp"
                    android:layout_height="30dp"
                    android:background="@drawable/code_empty_box"
                    android:layout_margin="6dp"/>
                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>
                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>
                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>

                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>
                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>
                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>
                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>

                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>
                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>
                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>
                <View android:layout_width="65dp" android:layout_height="30dp" android:background="@drawable/code_empty_box" android:layout_margin="6dp"/>

            </GridLayout>
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="4"
            android:alignmentMode="alignMargins"
            android:rowOrderPreserved="false"
            android:layout_marginTop="10dp">

            <!-- KOLOM KIRI -->
            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/code_box"
                android:text="int number = 10;"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_margin="6dp"/>

            <!-- KOLOM KANAN -->
            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/code_box"
                android:text="if (number > 5) {"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_margin="6dp"/>

            <!-- Pindahkan item berikutnya dengan urutan yang kamu mau -->
            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/code_box"
                android:text="}"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_margin="6dp"/>

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/code_box"
                android:text='System.out.println(\"Besar\");'
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_margin="6dp"/>

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/code_box"
                android:text="if (number > 5) {"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_margin="6dp"/>

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/code_box"
                android:text="} else {"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:layout_margin="6dp"/>

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/code_box"
                android:text='System.out.println(\"Kecil\");'
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:layout_margin="6dp"/>

        </GridLayout>

        <!-- BUTTON -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="KUNCI JAWABAN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_orange1"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>