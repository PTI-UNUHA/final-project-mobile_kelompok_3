<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lihat Jawaban"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <!-- Card 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_correct"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Apa output dari 'System.out.println(10 > 5);'?"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jawaban Anda: true"
                android:layout_marginTop="5dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Benar"
                android:textStyle="bold"
                android:layout_marginTop="3dp"
                android:textColor="#0A9A37" />
        </LinearLayout>

        <!-- Card 2 (jawaban salah contoh) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_wrong"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Boolean 'false || true' menghasilkan?"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jawaban Anda: false"
                android:layout_marginTop="5dp"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Salah"
                android:textStyle="bold"
                android:layout_marginTop="3dp"
                android:textColor="#C81A1A" />
        </LinearLayout>

        <!-- Tombol Ulangi Kuis -->
        <Button
            android:id="@+id/btnUlangi"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="ULANGI KUIS"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_green"
            android:layout_marginTop="6dp"/>

        <!-- Tombol Leaderboard -->
        <Button
            android:id="@+id/btnLeaderboard"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LIHAT LEADERBOARD"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_purple"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"/>
    </LinearLayout>
</ScrollView>