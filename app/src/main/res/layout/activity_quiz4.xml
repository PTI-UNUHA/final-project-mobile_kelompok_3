<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D6F0FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================= HEADER ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_header3"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CodeQuiz   Boolean Battle"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:30"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= BADGE ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge4"
            android:padding="8dp"
            android:text="Soal 4/5"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ================= CARD SOAL ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_card4"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Studi Kasus: Program Kasir"
                android:textColor="#1E3557"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Sebuah program kasir akan memberikan diskon 15% jika total belanja (variable 'total') lebih dari 200000. Jika tidak, maka tidak ada diskon (diskon = 0)."
                android:textColor="#465A78"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ================= PERTANYAAN ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Manakah struktur if-else yang paling tepat untuk kasus ini?"
            android:textColor="#1E3557"
            android:textSize="15sp" />

        <!-- ================= JAWABAN ================= -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/answer_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:columnCount="1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_answer4"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:tag="correct"
                android:text="if (total &gt; 200000) { diskon = 0.15; } else { diskon = 0; }"
                android:textColor="#43536A"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_answer4"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:tag="incorrect"
                android:text="if (total &gt;= 200000) { diskon = 0.15; }"
                android:textColor="#43536A"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_answer4"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:tag="incorrect"
                android:text="if (total &lt; 200000) { diskon = 0.15; } else { diskon = 0; }"
                android:textColor="#43536A"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_answer4"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:tag="incorrect"
                android:text="if (diskon) { total &gt; 200000; }"
                android:textColor="#43536A"
                android:textStyle="bold" />
        </androidx.gridlayout.widget.GridLayout>

        <!-- ================= BUTTON ================= -->
        <Button
            android:id="@+id/btnKuncitiga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button4"
            android:padding="12dp"
            android:text="SELESAIKAN KUIS"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
