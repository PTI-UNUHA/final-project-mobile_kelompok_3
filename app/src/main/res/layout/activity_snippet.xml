<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F3FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#2467FF"
            android:padding="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CodeQuiz"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Snippet"
                android:textColor="#FFFFFF"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:30"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- Soal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/robot_quiz"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soal 2/5"
                android:textColor="#334155"
                android:textSize="16sp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <!-- PROGRESS BAR -->
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:progress="40"
            android:progressTint="#2467FF"
            android:backgroundTint="#BFD7FF"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_marginTop="5dp"/>

        <!-- DRAG AREA -->
        <LinearLayout
            android:id="@+id/drag_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="170dp"
            android:background="@drawable/box_area"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:padding="15dp">

            <TextView
                android:id="@+id/drag_area_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERET KODE KE SINI"
                android:textColor="#6B7280"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

        </LinearLayout>

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/source_code_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columnCount="2"
            app:rowCount="4"
            app:alignmentMode="alignMargins"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/code_1"
                style="@style/CodeSnippet"
                android:tag="code_1"
                android:text="int number = 10;"/>

            <TextView
                android:id="@+id/code_2"
                style="@style/CodeSnippet"
                android:tag="code_2"
                android:text="if (number > 5) {"/>

            <TextView
                android:id="@+id/code_3"
                style="@style/CodeSnippet"
                android:tag="code_3"
                android:text="}"/>

            <TextView
                android:id="@+id/code_4"
                style="@style/CodeSnippet"
                android:tag="code_4"
                android:text="System.out.println(&quot;Besar&quot;);"/>

            <TextView
                android:id="@+id/code_5"
                style="@style/CodeSnippet"
                android:tag="code_5"
                android:text="if (number > 5) {"/>

            <TextView
                android:id="@+id/code_6"
                style="@style/CodeSnippet"
                android:tag="code_6"
                android:text="} else {"/>

            <TextView
                android:id="@+id/code_7"
                style="@style/CodeSnippet"
                android:tag="code_7"
                android:text="System.out.println(&quot;Kecil&quot;);"/>

        </androidx.gridlayout.widget.GridLayout>

        <!-- BUTTON -->
        <Button
            android:id="@+id/btnKuncisnippet"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="KUNCI JAWABAN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_orange1"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>